{
  "name": "partykit-dashboard",
  "version": "0.1.0",
  "description": "Observability for PartyKit: instrument your rooms, then run npx partykit-dashboard to see them live on a local page.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pass": {
      "types": "./dist/pass.d.ts",
      "default": "./dist/pass.js"
    },
    "./histogram": {
      "types": "./dist/histogram.d.ts",
      "default": "./dist/histogram.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./registry.js": {
      "types": "./registry.d.ts",
      "default": "./registry.js"
    },
    "./package.json": "./package.json",
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "default": "./dist/shared/index.js"
    }
  },
  "files": [
    "dist",
    "registry.js",
    "registry.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-page-assets.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build"
  },
  "peerDependencies": {
    "partykit": ">=0.0.115"
  },
  "devDependencies": {
    "@types/node": "^22",
    "happy-dom": "^20.14.5",
    "partykit": "0.0.115",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "bin": {
    "partykit-dashboard": "dist/cli/bin.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "partykit",
    "durable-objects",
    "websocket",
    "observability",
    "dashboard"
  ]
}
