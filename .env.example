# Shared password for the dashboard (also signs the session cookie).
DASHBOARD_PASSWORD=change-me

# Projects and environments the dashboard reads. Secrets are referenced by env var name.
DASHBOARD_PROJECTS=[{"name":"example","env":"local","host":"localhost:1999","secretEnv":"EXAMPLE_SECRET","presets":[{"name":"hello","body":{"status":"hello"}}]},{"name":"example","env":"broken","host":"localhost:1999","secretEnv":"MISSING_SECRET"},{"name":"example","env":"prod-demo","host":"localhost:1999","secretEnv":"EXAMPLE_SECRET","prod":true},{"name":"example","env":"offline","host":"localhost:1","secretEnv":"EXAMPLE_SECRET"}]

# Dashboard secret of the example project (must equal DASHBOARD_SECRET in examples/basic/.env).
EXAMPLE_SECRET=local-example-secret
